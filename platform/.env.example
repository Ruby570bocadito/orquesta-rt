# ============================================================================
# OrquestaRT — plantilla de entorno (z3, auditoría seguridad sesion 2)
#
#   cp platform/.env.example platform/.env   # y edite sus claves
#
# REGLA: ningún valor real de producción se commitea jamás. Este fichero
# solo documenta nombres de variables y valores de ejemplo inofensivos.
# ============================================================================

# --- Núcleo -----------------------------------------------------------------
# Base de operadores (JWT scrypt+HS256). El secreto JWT se genera y guarda
# en la propia BD al primer arranque: NUNCA copie una usuarios.db usada
# (contiene el secreto de firma — rotar si se expuso).
# DB_USUARIOS=usuarios.db
# TOKEN_HORAS=12                 # vida del token de sesión
# CONSOLE_ORIGINS=http://localhost:3000   # CORS de la consola (coma-separado)

# --- Router IA (híbrido local/frontera) -------------------------------------
# API_FRONTERA_BASE=https://open.bigmodel.cn/api/paas/v4
# API_FRONTERA_CLAVE=
# MODELO_FRONTERA=glm-4.6
# API_LOCAL_BASE=http://127.0.0.1:8001/v1
# MODELO_LOCAL=Qwen2.5-14B-Instruct
# POLITICA_SALIDA=permisiva    # | restrictiva (sin frontera no hay IA)

# --- Cadena de custodia ------------------------------------------------------
# CLAVE_CASO=            # si se omite se genera 256 bits y se persiste en db/clave-caso (0600)
# CLAVES_CASO_LEGADO=    # claves antiguas SOLO para verificar evidencias previas (coma-separado)

# --- SSO OIDC (Keycloak / cualquier IdP) ------------------------------------
# OIDC_ISSUER=http://keycloak:8080/realms/orquesta
# OIDC_CLIENT_ID=orquesta-client
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:3000/api/auth/sso/callback
# OIDC_ROL_JIT=lector          # rol de las altas just-in-time
# OIDC_AUTO_ALTA=1             # 0 = exige cuenta local preexistente
# OIDC_TENANT=predeterminada
# z3: si se define, el vínculo/alta SSO exige email federado VERIFICADO de
# estos dominios (coma-separado). Recomendado en producción.
# OIDC_DOMINIOS_PERMITIDOS=empresa.com

# --- Metasploit RPC (credenciales: verifique TLS salvo lab autofirmado) -----
# MSF_HOST=127.0.0.1
# MSF_PORT=55553
# MSF_SSL=1                    # 1 = msfrpcd con TLS
# MSF_TLS_VERIFICAR=1          # z3: 0 solo para labs autofirmados (consciente)
# MSF_USER=
# MSF_PASS=

# --- BloodHound CE -----------------------------------------------------------
# BLOODHOUND_URL=http://bloodhound.lab:8080
# BLOODHOUND_USER=
# BLOODHOUND_SECRET=
# BLOODHOUND_TLS_VERIFICAR=1   # z3: 0 solo para labs autofirmados

# --- Mythic C2 ---------------------------------------------------------------
# MYTHIC_URL=https://mythic.server:7443
# MYTHIC_TOKEN=
# MYTHIC_TLS_VERIFICAR=1       # z3: 0 solo para labs autofirmados

# --- MISP ----------------------------------------------------------------------
# MISP_URL=https://misp.lab
# MISP_KEY=
# MISP_SSL=1                   # "0" desactiva la verificación (solo labs)

# --- Motor Neo4j de rutas (lab o BloodHound graph) ---------------------------
# NEO4J_URL=http://localhost:7474
# NEO4J_USER=neo4j
# NEO4J_PASS=

# --- Active Directory (bind LDAP del operador) --------------------------------
# LDAP_HOST=dc01.corp.lab
# LDAP_BASE_DN=DC=corp,DC=lab
# LDAP_BIND_DN=CN=audit,CN=Users,DC=corp,DC=lab
# LDAP_BIND_CLAVE=

# --- SMTP (infra de phishing del equipo, con aprobación ROE) ------------------
# SMTP_HOST=
# SMTP_PUERTO=587
# SMTP_USUARIO=
# SMTP_CLAVE=
# SMTP_REMITENTE=phish@equipo-rojolab.com
# SMTP_TLS=1                   # STARTTLS obligatorio por defecto
# SMTP_TLS_SIN_VERIFICAR=      # z3: "1" solo labs autofirmados; por defecto se verifica

# --- OSINT ---------------------------------------------------------------------
# HIBP_API_KEY=                # haveibeenpwned.com (gratuita)
# PROVEEDOR_FILTRACIONES_BASE=

# --- Webhooks -------------------------------------------------------------------
# WEBHOOK_PERMITIR_METADATOS=  # z3: "1" solo si su receptor ES un endpoint de metadatos (escape documentado)

# --- Persistencia del lab (z3, sesión 7) ----------------------------------------
# Hogares del laboratorio donde el arsenal de persistencia puede implantar
# (rutas absolutas, separadas por ":"). Por defecto SOLO el HOME del usuario
# que ejecuta el orquestador. La raíz que manda cada petición viaja en los
# argumentos de la aprobación del boundary y fuera de estos hogares se
# rechaza (F37).
# ORQUESTA_LAB_HOGARES=/home/lab-acme:/home/lab-otro

# --- Recon TLS (z3) --------------------------------------------------------------
# Por defecto los sondeos de recon/OSINT admiten certificados autofirmados
# de los labs del alcance. En producción contra infraestructura real:
# RECON_TLS_ESTRICTO=1
